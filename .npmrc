# shadow-cljs resolves an npm require by walking the real node_modules tree, so
# a transitive dependency that is not hoisted is simply not found — @ipld/dag-cbor
# needs cborg and multiformats, and pnpm's default isolated layout hides both.
# Chasing them one at a time means declaring another package's dependencies as
# our own and having them drift. A hoisted tree is what npm gives the reference
# actor (cloud-itonami-marketplace-order), so the build behaves the same here.
node-linker=hoisted
